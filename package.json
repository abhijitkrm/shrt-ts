{
  "name": "urlshort-ts",
  "version": "1.0.0",
  "description": "High-performance URL shortener backend",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:node": "SERVER=node node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "bench": "pnpm build && tsx bench/bench.ts",
    "smoke": "pnpm build && bash scripts/smoke.sh"
  },
  "keywords": [
    "url-shortener"
  ],
  "license": "ISC",
  "dependencies": {
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "autocannon": "^8.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
